{
  "name": "sanjaiportfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:markdown": "node --test tests/portfolio-markdown.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:likes": "node scripts/setup-blog-likes.mjs",
    "dev:party": "node --import tsx scripts/party/server.ts",
    "dev:all": "node --import tsx scripts/party/dev.ts",
    "test:party": "node --import tsx --test tests/party/*.test.ts",
    "party:worker:dev": "wrangler dev --config workers/party/wrangler.jsonc --port 8787",
    "party:worker:check": "tsc -p workers/party/tsconfig.json && wrangler deploy --dry-run --config workers/party/wrangler.jsonc --env \"\"",
    "party:worker:deploy": "wrangler deploy --config workers/party/wrangler.jsonc --env \"\"",
    "test:party:ui": "playwright test --config tests/party-ui/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:server": "node --import tsx --test tests/server/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:markdown && npm run test:server && npm run test:party && npm run party:worker:check && npm run build",
    "party:worker:check:staging": "tsc -p workers/party/tsconfig.json && wrangler deploy --dry-run --config workers/party/wrangler.jsonc --env staging",
    "party:worker:deploy:staging": "wrangler deploy --config workers/party/wrangler.jsonc --env staging"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.0.2",
    "@next/mdx": "^16.4.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@trigger.dev/sdk": "^4.5.16",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.546.0",
    "mdast-util-to-markdown": "^2.2.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-tweet": "^3.2.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "engine.io-client": {
      "ws": "^8.22.0"
    },
    "miniflare": {
      "undici": "^7.30.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
