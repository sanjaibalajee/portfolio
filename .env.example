# Neon Postgres connection string
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Homepage URL: https://www.sanjaibalajee.com
# Callback URL: https://www.sanjaibalajee.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Immutable public GitHub account id for sanjaibalajee — the only account
# allowed into /switch/dashboard.
ALLOWED_GITHUB_ID=87613424

# Shared bearer token for POST /api/switch/ingest. Must match INGEST_TOKEN in
# the private submissions repo. Generate with: openssl rand -hex 32
SWITCH_INGEST_TOKEN=

# Trigger.dev — only needed locally to deploy the sync task
# (npx trigger.dev@latest deploy). The task's own secrets
# (LEETCODE_SESSION, LEETCODE_CSRF_TOKEN, INGEST_URL, INGEST_TOKEN)
# are set in the Trigger.dev dashboard, not here.
# Production INGEST_URL: https://www.sanjaibalajee.com/api/switch/ingest
# INGEST_TOKEN must keep matching SWITCH_INGEST_TOKEN after the domain move.
TRIGGER_PROJECT_REF=

# Party games: run `npm run dev:all` locally. Production uses the Durable Object
# worker; set its HTTPS/WSS origins here before building the portfolio.
PARTY_SERVER_URL=
PARTY_WS_URL=
# Local companion server only. Configure Groq separately with Wrangler secrets
# for the production worker. Never prefix this key with NEXT_PUBLIC_.
GROQ_API_KEY=
PARTY_PORT=8787
PARTY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PARTY_AI_DAILY_LIMIT=40
